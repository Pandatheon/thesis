@inproceedings{frisonEfficientImplementationPartial2016,
  title = {An Efficient Implementation of Partial Condensing for {{Nonlinear Model Predictive Control}}},
  booktitle = {2016 {{IEEE}} 55th {{Conference}} on {{Decision}} and {{Control}} ({{CDC}})},
  author = {Frison, Gianluca and Kouzoupis, Dimitris and Jørgensen, John Bagterp and Diehl, Moritz},
  date = {2016-12},
  pages = {4457--4462},
  doi = {10.1109/CDC.2016.7798946},
  url = {https://ieeexplore.ieee.org/document/7798946},
  urldate = {2026-04-23},
  abstract = {Partial (or block) condensing is a recently proposed technique to reformulate a Model Predictive Control (MPC) problem into a form more suitable for structure-exploiting Quadratic Programming (QP) solvers. It trades off horizon length for input vector size, and this degree of freedom can be employed to find the best problem size for the QP solver at hand. This paper proposes a Hessian condensing algorithm particularly well suited for partial condensing, where a state component is retained as an optimization variable at each stage of the partially condensed MPC problem. The optimal input-horizon trade-off is investigated from a theoretical point of view (based on algorithms flop count) as well as by benchmarking (in practice, the performance of linear algebra routines for different matrix sizes plays a key role). Partial condensing can also be seen as a technique to replace many operations on small matrices with fewer operations on larger matrices, where linear algebra routines perform better. Therefore, in case of small-scale MPC problems, partial condensing can greatly improve performance beyond the flop count reduction.},
  eventtitle = {2016 {{IEEE}} 55th {{Conference}} on {{Decision}} and {{Control}} ({{CDC}})},
  keywords = {Computational efficiency,Cost function,Linear algebra,Manganese,Predictive control,Quadratic programming},
}

@thesis{mcsweeneyModifiedCholeskyDecomposition2017,
  type = {mathesis},
  title = {Modified {{Cholesky Decomposition}} and {{Applications}}},
  author = {McSweeney, Thomas},
  date = {2017-09-08},
  institution = {University of Manchester},
  url = {https://eprints.maths.manchester.ac.uk/2599/},
  urldate = {2026-04-20},
  abstract = {The modified Cholesky decomposition is one of the standard tools in various areas of mathematics for dealing with symmetric indefinite matrices that are required to be positive definite. We survey the literature and determine which of the existing modified Cholesky algorithms is most suitable for inclusion in the Numerical Algorithms Group (NAG) software library, focussing in particular on the algorithms of Gill, Murray and Wright, Schnabel and Eskow, Cheng and Higham, and Moré and Sorensen. In order to make this determination we consider how best to take advantage of modern computer architectures and existing numerical software. We create an efficient implementation of the chosen algorithm and perform extensive numerical testing to ensure that it works as intended. We then discuss various applications of the modified Cholesky decomposition and show how the new implementation can be used for some of these. In particular, significant attention is devoted to describing how the modified Cholesky decomposition can be used to compute an upper bound on the distance to the nearest correlation matrix.},
  langid = {english},
}

